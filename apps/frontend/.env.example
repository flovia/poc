# Fixture data is the default. You do not need to set a data source for the
# public Vercel mock; leftover BFF_URL values are ignored unless the source is
# explicitly bff.
NEXT_PUBLIC_SITE_URL=https://demo.flovia402.com

# Local BFF-backed development only. Uncomment to opt in.
# NEXT_PUBLIC_FLOVIA_DATA_SOURCE=bff
# FLOVIA_FRONTEND_DATA_SOURCE=bff
# BFF_URL=http://localhost:3001
# NEXT_PUBLIC_BFF_URL=/api
